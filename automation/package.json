{
  "name": "shoptest-amazon-qa",
  "version": "1.0.0",
  "private": true,
  "description": "Senior QA take-home: Playwright + TypeScript POM framework for amazon.com Search / PDP / Cart flows",
  "scripts": {
    "test": "playwright test",
    "test:desktop": "playwright test --project=chromium-desktop",
    "test:mobile": "playwright test --project=mobile-chrome",
    "test:headed": "playwright test --headed --project=chromium-desktop",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.0",
    "@types/node": "^26.1.2",
    "typescript": "^5.5.0"
  }
}
